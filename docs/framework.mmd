    R7 --> MCP4
    R3 --> MCP3
    C1 --> MCP5
    C5 --> MCP2
    A2 --> MCP3
    CD1 --> MCP3
    M2 --> MCP2
    P2 --> MCP2
    P2 --> MCP4

